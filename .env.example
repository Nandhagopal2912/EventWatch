EVENTWATCH_API_KEY=replace-with-a-local-secret
JAVA_BACKEND_URL=http://localhost:8080/receive
HTTP_PORT=8080
COLLECTOR_PORT=8082
# DATABASE_URL selects the backend; unset means SQLite at DATABASE_PATH.
DATABASE_URL=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_PATH=events.db
SHUTDOWN_GRACE_SECONDS=5
# Agent exposure. Loopback needs no key; any other bind requires CAPTURE_API_KEY.
COLLECTOR_BIND=127.0.0.1
CAPTURE_API_KEY=
CAPTURE_REQUIRE_KEY=false
BACKEND_CA_FILE=
BACKEND_TLS_SKIP_VERIFY=false
TLS_ENABLED=false
TLS_KEYSTORE_PATH=
TLS_KEYSTORE_PASSWORD=
TLS_KEYSTORE_TYPE=PKCS12
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
METRICS_REQUIRE_KEY=false
# Agent identity. Unset means a stable id is generated and stored beside the queue.
HOST_ID=
HOSTNAME_OVERRIDE=
HOST_ID_FILE=
PENDING_EVENTS_DIR=pending-events
QUEUE_CAPACITY=1000
QUEUE_RETRY_SECONDS=5
DATABASE_POOL_SIZE=10
RETENTION_DAYS=0
RETENTION_SWEEP_MINUTES=60
RATE_LIMIT_PER_MINUTE=100
CPU_ALERT_THRESHOLD=85
RAM_ALERT_THRESHOLD=80
REPEATED_ERROR_THRESHOLD=5
LOG_FORMAT=json
NOTIFICATIONS_ENABLED=false
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_TIMEOUT_SECONDS=5
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_DELAY_MILLIS=1000
NOTIFICATION_REMINDER_SECONDS=900
MAVEN_OPTS=-Xms64m -Xmx128m
